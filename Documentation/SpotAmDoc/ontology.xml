        <rdfs:range rdf:resource="https://w3id.org/spot/am#AxisRelationType"/>
        <rdfs:comment xml:lang="en">Specifies which kind of geometrical relation the two mapped axes have to each other.</rdfs:comment>
        <rdfs:label xml:lang="en">has axis relation type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/spot/am#hasBoundaryPoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/spot/am#hasBoundaryPoint">
        <rdfs:domain rdf:resource="https://w3id.org/spot#Axis"/>
        <rdfs:range rdf:resource="https://w3id.org/spot/am#BoundaryPoint"/>
        <rdfs:comment xml:lang="en">Relates an axis to a boundary point. These points can than be mapped/related to a reference space.
        Usually, only Axes of Entity Spaces get Boundary Point Definitions.</rdfs:comment>
        <rdfs:label xml:lang="en">has boundary point</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/spot/am#hasBoundaryPointMapping -->


    <owl:ObjectProperty rdf:about="https://w3id.org/spot/am#hasBoundaryPointMapping">
