        <rdfs:range rdf:resource="https://w3id.org/spot/am#BoundaryPoint"/>
        <rdfs:comment xml:lang="en">Specifies which EntityAxis/ Source boundary point is being mapping</rdfs:comment>
        <rdfs:label xml:lang="en">has source point</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/spot/am#hasTargetAxis -->


    <owl:ObjectProperty rdf:about="https://w3id.org/spot/am#hasTargetAxis">
