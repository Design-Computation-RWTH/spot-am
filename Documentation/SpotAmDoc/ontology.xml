    <!-- https://w3id.org/spot/am#Antiparallel -->


    <owl:NamedIndividual rdf:about="https://w3id.org/spot/am#Antiparallel">
        <rdf:type rdf:resource="https://w3id.org/spot/am#AxisRelationType"/>
        <rdfs:comment xml:lang="en">The source axis is antiparallel (parallel but directed in opposite direction) to the target axis.</rdfs:comment>
        <rdfs:label xml:lang="en">Antiparallel</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.oed.com/dictionary/antiparallel_adj"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/spot/am#Approximate -->


    <owl:NamedIndividual rdf:about="https://w3id.org/spot/am#Approximate">
        <rdf:type rdf:resource="https://w3id.org/spot/am#Accuracy"/>
        <rdfs:comment xml:lang="en">The relationship between the axes defined in the axis mapping corresponds closely to reality, with minor deviations (e.g., nearly parallel axes).</rdfs:comment>
        <rdfs:label xml:lang="en">Approximate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/spot/am#Broad -->


    <owl:NamedIndividual rdf:about="https://w3id.org/spot/am#Broad">
        <rdf:type rdf:resource="https://w3id.org/spot/am#Accuracy"/>
        <rdfs:comment xml:lang="en">The source axis is assigned to the closest matching target axis in the context of the defined relationship, despite significant discrepancies.</rdfs:comment>
        <rdfs:label xml:lang="en">Broad</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/spot/am#Codirectional -->


    <owl:NamedIndividual rdf:about="https://w3id.org/spot/am#Codirectional">
        <rdf:type rdf:resource="https://w3id.org/spot/am#AxisRelationType"/>
        <rdfs:comment xml:lang="en">The source axis is parallel to the target axis and having the same direction.</rdfs:comment>
        <rdfs:label xml:lang="en">Codirectional</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.oed.com/dictionary/codirectional_adj"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/spot/am#Exact -->


    <owl:NamedIndividual rdf:about="https://w3id.org/spot/am#Exact">
        <rdf:type rdf:resource="https://w3id.org/spot/am#Accuracy"/>
        <rdfs:comment xml:lang="en">The relationship between the axes defined in the axis mapping corresponds exactly to reality.</rdfs:comment>
        <rdfs:label xml:lang="en">Exact</rdfs:label>
    </owl:NamedIndividual>
