        <rdfs:range rdf:resource="https://w3id.org/spot/am#AxisMapping"/>
        <rdfs:comment xml:lang="en">Relates an appearance to an axis mapping object. One appearance can have multiple Axis Mappings. Typically three: For each Entity Axis one.</rdfs:comment>
        <rdfs:label xml:lang="en">has axis mapping</rdfs:label>
