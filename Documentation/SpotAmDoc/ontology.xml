        <rdfs:comment xml:lang="en">Specifies to which target axis the source axis is mapped. The target axis must be from another space instance
    as the source axis.</rdfs:comment>
        <rdfs:label xml:lang="en">has target axis</rdfs:label>
    </owl:ObjectProperty>
    


