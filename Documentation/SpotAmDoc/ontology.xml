        <rdfs:range rdf:resource="https://w3id.org/spot/am#BoundaryPointMapping"/>
        <rdfs:comment xml:lang="en">Relates an appearance to a boundary point mapping. Each appearance can have multiple boundary point mappings.
     For mappings of volume spaces, up to 6 boundary points mappings are usually needed (min and max point of each axis).</rdfs:comment>
        <rdfs:label xml:lang="en">has boundary point mapping</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/spot/am#hasSourceAxis -->


    <owl:ObjectProperty rdf:about="https://w3id.org/spot/am#hasSourceAxis">
        <rdfs:domain rdf:resource="https://w3id.org/spot/am#AxisMapping"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/spot#Axis"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/spot#hasAxis"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/spot#EntitySpace"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Specifies which Entity Axis/Source axis is being mapped. Only Axes from Entity Spaces should be in the range of this property.</rdfs:comment>
        <rdfs:label xml:lang="en">has source axis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/spot/am#hasSourcePoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/spot/am#hasSourcePoint">
